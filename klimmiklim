# Σταθερές
base_charge = 2.0       # Πάγιο
tax = 5                 # Φόρος
vat_rate = 0.24         # Συντελεστής ΦΠΑ

# Εισαγωγή μονάδων νερού
units = int(input("Dose tis monades nerou: "))   # Μονάδες νερού

# Υπολογισμός κλιμακωτής και μη κλιμακωτής χρέωσης
if units <= 5:
    unit_charge = 0.0 * units
    unit_charge1 = 0.0 * units

elif units <= 10:
    unit_charge = 0.0 * 5 + (units - 5) * 0.5
    unit_charge1 = 0.5 * units

elif units <= 20:
    unit_charge = 0.0 * 5 + 5 * 0.5 + (units - 10) * 0.7
    unit_charge1 = 0.7 * units

else:
    unit_charge = 0.0 * 5 + 5 * 0.5 + 10 * 0.7 + (units - 20) * 1
    unit_charge1 = 1 * units

# Κλιμακωτή χρέωση
total_charge = unit_charge + base_charge + tax

# Υπολογισμός ΦΠΑ
vat = total_charge * vat_rate

# Προσθήκη ΦΠΑ
total_charge = total_charge + vat

# Μη κλιμακωτή χρέωση
total_charge1 = unit_charge1 + base_charge + tax

# Υπολογισμός ΦΠΑ
vat = total_charge1 * vat_rate

# Προσθήκη ΦΠΑ
total_charge1 = total_charge1 + vat

# Εμφάνιση αποτελεσμάτων
print(f"H teliki xreosi klimakota einai: {total_charge:.2f} euro")
print(f"H teliki xreosi mi klimakota einai: {total_charge1:.2f} euro")
